{
  "name": "@n-uf/doodl-go",
  "version": "26.7.0",
  "private": false,
  "description": "Ready-to-use UI shell for doodl canvas drawing and PDF annotation.",
  "keywords": [
    "react",
    "canvas",
    "drawing",
    "annotation",
    "ui",
    "doodl"
  ],
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/doodl.git",
    "directory": "packages/doodl-go"
  },
  "homepage": "https://doodl.n-uf.com/",
  "bugs": {
    "url": "https://github.com/n-uf/doodl/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "pnpm typecheck",
    "prepublishOnly": "pnpm build",
    "release": "if [ \"$npm_config_nobump\" = \"true\" ]; then npm publish --access public; else node ./scripts/calendar-version-bump.mjs --apply && npm publish --access public; fi",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "release:next-version": "node ./scripts/calendar-version-bump.mjs --dry-run"
  },
  "dependencies": {
    "@n-uf/doodl": "workspace:*",
    "@n-uf/doodl-pdf-react": "workspace:*",
    "@n-uf/doodl-react": "workspace:*"
  },
  "peerDependencies": {
    "pdfjs-dist": "^5.0.0",
    "react": "^19",
    "react-dom": "^19",
    "react-pdf": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "react-pdf": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
