{
  "name": "pdf-doodl-workspace",
  "version": "26.7.0",
  "private": true,
  "description": "Workspace for pdf-doodl (doodl packages) and homepage app.",
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo run dev --filter=doodl-web",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=./packages/*",
    "check": "turbo run typecheck test",
    "lint": "turbo run lint",
    "release": "node ./scripts/release-workspace.mjs"
  },
  "devDependencies": {
    "turbo": "^2.8.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "pdfjs-dist": "5.7.284"
    }
  }
}
