{
  "name": "pdf-doodl-workspace",
  "version": "26.7.0",
  "private": true,
  "description": "Workspace for pdf-doodl (doodl packages) and homepage app.",
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --filter doodl-web dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter doodl-web build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck && pnpm --filter doodl-web typecheck",
    "test": "pnpm -r --filter './packages/*' test",
    "check": "pnpm typecheck && pnpm test",
    "release": "node ./scripts/release-workspace.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
